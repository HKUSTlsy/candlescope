{
  "name": "candlescope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": ".venv/bin/python scripts/server.py",
    "start": ".venv/bin/python scripts/server.py",
    "test:server": ".venv/bin/python -m unittest discover -s tests -p \"test_server.py\"",
    "service:start": ".venv/bin/python scripts/service.py start",
    "service:stop": ".venv/bin/python scripts/service.py stop",
    "service:status": ".venv/bin/python scripts/service.py status",
    "amount:backfill": ".venv/bin/python scripts/backfill_amount.py --all-cached"
  },
  "dependencies": {
    "@luxalgo/vela": "0.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "license": "Apache-2.0"
}
